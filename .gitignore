node_modules/
dist/
dist-electron/
out/
.DS_Store
*.log

# app/installation prefs are machine-local, not shared state (SPEC.md §7)
config/settings.json

# Warp calibration describes one physical surface in one room (I-5). It is
# machine-local for the same reason settings.json is, and sharing one would be
# actively wrong: a calibration from another wall is worse than none.
calibration/warp.json
# S3: rotating pre-gesture snapshots of the room. A backup of THIS session
# on THIS machine; the room itself (surfaces.json) is what gets committed.
calibration/surfaces.history/
measurements/*.log

# Golden-frame previews: written on every render-test run, for eyeballing a
# mismatch. The hashes in test/golden/ are the committed artefact, not these.
.golden-preview/
.probe/

# The downloaded catalog library is the operator's collection, like their room
# (calibration/) — machine-local, brought home through the editor's catalog
# panel with an I-10 record per asset in index.json. Never source.
assets/library/
