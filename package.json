{
  "name": "projection-engine",
  "version": "0.0.0",
  "private": true,
  "description": "Interactive projection engine \u2014 see SPEC.md",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:electron && npm run build:web",
    "build:electron": "tsc -p tsconfig.node.json && vite build --config vite.preload.config.ts",
    "build:web": "vite build",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:render": "npm run build:web && electron scripts/golden.mjs"
  },
  "dependencies": {
    "pixi.js": "8.20.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.1.1",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
